{
  "schemaVersion": 1,
  "key": "SUPPORT_TRIAGE",
  "name": "Support ticket triage",
  "inputSchema": {
    "ticket": {
      "type": "object",
      "required": true
    },
    "customerId": {
      "type": "string",
      "required": true
    }
  },
  "outputSchema": {
    "category": {
      "type": "string",
      "required": true
    },
    "reply": {
      "type": "string"
    },
    "escalated": {
      "type": "string",
      "required": true
    }
  },
  "output": {
    "category": {
      "$ref": "states.classify.output.category"
    },
    "reply": {
      "$ref": "states.respond.output.reply",
      "default": null
    },
    "escalated": {
      "$ref": "states.escalate.status",
      "default": "NOT_RUN"
    }
  },
  "settings": {
    "timeoutMs": 600000,
    "maxTransitionsPerRun": 20
  },
  "startAt": "fetch_customer",
  "states": {
    "fetch_customer": {
      "type": "HTTP",
      "display": {
        "label": "Fetch customer",
        "position": {
          "x": 0,
          "y": 0
        }
      },
      "next": "classify",
      "onError": {
        "action": "CONTINUE"
      },
      "http": {
        "connection": "crm",
        "method": "GET",
        "path": {
          "$template": "/customers/{{input.customerId}}"
        },
        "responseType": "JSON"
      }
    },
    "classify": {
      "type": "INTENT",
      "next": "route",
      "intent": {
        "intent": "SUPPORT_TICKET_CLASSIFIER",
        "vars": {
          "ticket": {
            "$ref": "input.ticket.text"
          },
          "customerTier": {
            "$fn": "COALESCE",
            "args": [
              {
                "$ref": "states.fetch_customer.output.body.plan"
              },
              "standard"
            ]
          }
        }
      }
    },
    "route": {
      "type": "CHOICE",
      "choice": {
        "choices": [
          {
            "id": "critical",
            "condition": {
              "op": "AND",
              "conditions": [
                {
                  "path": "states.classify.output.severity",
                  "op": "EQUALS",
                  "value1": "CRITICAL"
                },
                {
                  "path": "states.classify.output.confidence",
                  "op": "MORE_THAN_EQUAL",
                  "value1": 0.8
                }
              ]
            },
            "next": "escalate"
          }
        ],
        "default": "respond"
      }
    },
    "escalate": {
      "type": "HTTP",
      "next": "done",
      "http": {
        "connection": "ticketing",
        "method": "POST",
        "path": "/escalations",
        "body": {
          "ticketId": {
            "$ref": "input.ticket.id"
          },
          "summary": {
            "$template": "[{{states.classify.output.category}}] ticket {{input.ticket.id}} from customer {{input.customerId}}"
          },
          "team": {
            "$ref": "constants.escalationTeam"
          },
          "dueAt": {
            "$fn": "DATE_ADD",
            "args": [
              {
                "$ref": "run.startedAt"
              },
              {
                "$ref": "constants.slaHours"
              },
              "HOURS"
            ]
          }
        },
        "responseType": "JSON",
        "expectStatus": [
          201
        ]
      }
    },
    "respond": {
      "type": "INTENT",
      "next": "publish",
      "intent": {
        "intent": "SUPPORT_RESPONSE_WRITER",
        "vars": {
          "ticket": {
            "$ref": "input.ticket.text"
          },
          "category": {
            "$ref": "states.classify.output.category"
          },
          "customerName": {
            "$ref": "states.fetch_customer.output.body.name",
            "default": "customer"
          }
        }
      }
    },
    "publish": {
      "type": "TRANSFORM",
      "next": "done",
      "transform": {
        "output": {
          "ticketId": {
            "$ref": "input.ticket.id"
          },
          "reply": {
            "$fn": "TRIM",
            "args": [
              {
                "$ref": "states.respond.output.reply"
              }
            ]
          },
          "replyLength": {
            "$fn": "LENGTH",
            "args": [
              {
                "$ref": "states.respond.output.reply"
              }
            ]
          },
          "tags": {
            "$fn": "SPLIT",
            "args": [
              {
                "$ref": "states.classify.output.category"
              },
              "/"
            ]
          },
          "priority": {
            "$fn": "IF",
            "args": [
              {
                "$fn": "GTE",
                "args": [
                  {
                    "$ref": "states.classify.output.confidence"
                  },
                  0.9
                ]
              },
              "high",
              "normal"
            ]
          },
          "attachmentIds": {
            "$ref": "input.ticket.attachments[*].id",
            "default": null
          },
          "attempt": {
            "$fn": "ADD",
            "args": [
              {
                "$ref": "run.attempt"
              },
              1
            ]
          }
        }
      }
    },
    "done": {
      "type": "END",
      "end": {
        "outcome": "SUCCEED"
      }
    }
  },
  "constants": {
    "slaHours": 4,
    "escalationTeam": "tier2"
  }
}
